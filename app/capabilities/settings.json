{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "What the Settings window may ask the backend to do",
  "windows": [
    "settings"
  ],
  "permissions": [
    "allow-app-info",
    "allow-get-general",
    "allow-set-general",
    "allow-get-autostart",
    "allow-get-memory-status",
    "allow-set-autostart",
    "allow-open-config-folder",
    "allow-get-shortcut-errors",
    "allow-reload-triggers",
    "allow-list-items",
    "allow-save-item",
    "allow-delete-item",
    "allow-new-item-id",
    "allow-validate-layout",
    "allow-list-layout-templates",
    "allow-layout-from-template",
    "allow-export-settings",
    "allow-open-import",
    "allow-apply-import",
    "allow-discard-import",
    "allow-list-variables",
    "allow-test-rule",
    "allow-preview-files",
    "allow-button-reach",
    "allow-get-update-view",
    "allow-check-update",
    "allow-install-update",
    "allow-set-update-token",
    "allow-get-safe",
    "allow-set-safe",
    "allow-test-safe-folder",
    "allow-pick-folder",
    "allow-list-connections",
    "allow-set-connection-secret",
    "allow-connect-connection",
    "allow-cancel-sign-in",
    "allow-disconnect-connection",
    "allow-test-connection",
    "allow-describe-connection",
    "allow-preview-options",
    "allow-list-chats",
    "allow-pin-chat",
    "allow-set-chat-pinned",
    "allow-remove-chat",
    "allow-open-link",
    "allow-report-painted",
    "allow-get-timings",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
