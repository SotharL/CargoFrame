{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "What the CargoFrame (capture) window may ask the backend to do",
  "windows": [
    "capture",
    "capture-*"
  ],
  "permissions": [
    "allow-get-session",
    "allow-get-session-image",
    "allow-get-session-clip",
    "allow-close-capture",
    "allow-edit-layout",
    "allow-app-info",
    "allow-get-general",
    "allow-fetch-options",
    "allow-set-edited-image",
    "allow-read-text",
    "allow-add-files",
    "allow-read-offered-file",
    "allow-set-clip-mark",
    "allow-set-clip-layer",
    "allow-share",
    "allow-open-link",
    "allow-open-settings",
    "allow-report-painted",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
